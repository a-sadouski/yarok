# Nuxt reads this file in development. Backend secrets belong in yarok-be/.env.
# API proxy target; set before building production (embedded in routeRules).
YAROK_BACKEND_URL=http://localhost:5050
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-visible key; restrict allowed origins in the Yandex developer console.
NUXT_PUBLIC_YANDEX_MAPS_API_KEY=
